# =========================================================
# 02_figures_cross_scenario.R
# Senaryolar arası birleşik figürler (dikey istif, 3 panel)
# Kaynak PNG'ler 01_generate_ssp_outputs.R tarafından her SSP için üretilir.
# Ön koşul: init.R / paths.R sourced (here, DIR_OUTPUT_CROSS, theme_thesis, ...)
# =========================================================

library(magick)
library(patchwork)
library(ggplot2)
library(grid)
library(here)

SSP_LIST <- c("ssp126", "ssp245", "ssp585")   # klasör isimleriyle aynı olmalı

# ---------------------------------------------------------
# 0) Kaynak figürleri ÜÇ senaryo için (yeniden) ÜRET  —  EN ÖNEMLİ ADIM
#
#    KRİTİK: 01_...R senaryoyu Sys.getenv("SSP_SCENARIO") ile okur ve
#    SSP_LABEL'i kendi tablosundan yeniden atar. Bu yüzden döngüde
#    SSP_CODE / SSP_LABEL set etmek İŞE YARAMAZ; ortam değişkenini
#    (Sys.setenv) set etmek gerekir. Aksi halde her iterasyon aynı
#    senaryoyu üretir ve diskte eski (yanlış dilli) PNG'ler kalır.
#
#    Döngü birleştirmeden ÖNCE çalışmalı ki hiçbir birleşik figür
#    bayat kaynaktan üretilmesin; eski PNG'ler aynı adla ÜZERİNE yazılır.
# ---------------------------------------------------------
for (ssp in SSP_LIST) {
  Sys.setenv(SSP_SCENARIO = ssp)
  source(here("R", "04_results", "01_generate_ssp_outputs.R"))
}

# ---------------------------------------------------------
# Yardımcı: verilen figürü her SSP için oku, grob'a çevir,
#           dikey istifle (ncol = 1) ve 300 DPI kaydet.
#           (rasterGrob önceden render edilmiş PNG'leri döşer; panel
#            etiketleri/lejantları kaynak figüre gömülüdür — dil/lejant
#            düzeltmesi 01_...R'de yapılır, burada değil.)
#           Eksik dosya varsa o senaryo atlanır; hiç yoksa uyarır.
# ---------------------------------------------------------
combine_vertical <- function(fig_name, out_name, width = 10, height = 15) {
  grobs <- lapply(SSP_LIST, function(s) {
    path <- here("outputs", s, "figures", fig_name)
    if (file.exists(path)) rasterGrob(image_read(path), interpolate = TRUE) else NULL
  })
  grobs <- grobs[!vapply(grobs, is.null, logical(1))]
  if (length(grobs) == 0L) {
    warning("Hic figur bulunamadi, atlaniyor: ", fig_name)
    return(invisible(NULL))
  }
  combined <- wrap_plots(grobs) + plot_layout(ncol = 1)
  ggsave(
    filename = here(DIR_OUTPUT_CROSS, out_name),
    plot = combined, dpi = 300, width = width, height = height, units = "in"
  )
  message(sprintf("Kaydedildi: %-40s (%d panel)", out_name, length(grobs)))
  invisible(combined)
}

# ---------------------------------------------------------
# Birlestirilecek TUM senaryo-panelli figurler
# (kaynak dosya adi 01_...R'deki ggsave adlariyla birebir ayni;
#  yeni bir figur eklemek icin tek satir ekleyin)
#  Not: fig_yearly_risk_en (Ingilizce alternatif) ve tek-senaryo
#  figurleri kasitli olarak disarida; gerekiyorsa satir ekleyin.
# ---------------------------------------------------------
