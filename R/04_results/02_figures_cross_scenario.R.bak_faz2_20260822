  list("fig_heatmap_lambda.png", "combined_plot_heatmap_lambda.png",            12, 15),
  list("fig_pest_season.png",    "combined_plot_pest_season.png",               10, 15),
  list("fig_yearly_risk.png",    "combined_plot_yearly_risk.png",                9, 15),
  list("fig_import_trend.png",   "combined_plot_import_trend.png",               9, 15),
  list("fig_import_heatmap.png", "combined_plot_import_heatmap.png",            12, 15),
  list("fig_validation.png",     "combined_plot_validation.png",                12, 15),
  list("fig_prcc.png",           "combined_plot_prcc.png",                       9, 15),
  list("fig_csi_heat.png",       "combined_plot_csi_heat.png",                  10, 15),
  list("fig_csi_trend.png",      "combined_plot_csi_trend.png",                  9, 15),
  list("fig_decade.png",         "combined_plot_decade.png",                     9, 15),
  list("fig_season.png",         "combined_plot_season.png",                     9, 15),
  # asagidakiler 01_...R'de kosullu bloklarda uretilir (paket varsa);
  # dosya yoksa combine_vertical otomatik atlar
  list("fig_tornado.png",        "combined_plot_tornado.png",                    9, 15),
