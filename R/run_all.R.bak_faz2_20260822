# -----------------------------------------------------------------------------
# Locale: yalnizca karakter siniflandirmasi. LC_NUMERIC'e DOKUNMA
# (ondalik ayraci "." kalmali; "," as.numeric() hatalarina yol acar).
# -----------------------------------------------------------------------------
options(encoding = "UTF-8")
try(Sys.setlocale("LC_CTYPE", "Turkish_Turkey.utf8"), silent = TRUE)
try(Sys.setlocale("LC_CTYPE", "tr_TR.UTF-8"),         silent = TRUE)

t0      <- Sys.time()
FAILED  <- character(0)

source_utf8 <- function(path) {
  if (!file.exists(path)) stop("Dosya yok: ", path, call. = FALSE)
  source(path, encoding = SOURCE_ENCODING, local = FALSE)
}

check_fresh <- function(paths, since) {
  for (p in paths) {
    if (!file.exists(p))
      stop(sprintf("[FRESHNESS] Beklenen dosya yok: %s", p), call. = FALSE)
    if (file.mtime(p) < since)
      stop(sprintf("[FRESHNESS] '%s' bu kosumda guncellenmedi.", p), call. = FALSE)
  }
  invisible(TRUE)
}

step <- function(label, expr, check_paths = NULL) {
  cat(sprintf("\n=== [%s] basladi: %s ===\n", format(Sys.time(), "%H:%M:%S"), label))
  t_step <- Sys.time()
  ok <- tryCatch({
    force(expr)
    if (!is.null(check_paths)) check_fresh(check_paths, t_step)
    TRUE
  }, error = function(e) {
    cat(sprintf("!!! HATA [%s]: %s\n", label, conditionMessage(e)))
    FAILED <<- c(FAILED, sprintf("%s :: %s", label, conditionMessage(e)))
    FALSE
  })
  cat(sprintf("=== [%s] %s: %s (%.1f dk) ===\n",
              format(Sys.time(), "%H:%M:%S"),
              if (ok) "bitti" else "BASARISIZ", label,
              as.numeric(difftime(Sys.time(), t_step, units = "mins"))))
  invisible(ok)
}

