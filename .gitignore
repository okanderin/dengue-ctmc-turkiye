# =============================================================================
# .gitignore — dengue-ctmc-turkiye
# Public reproducibility repository: code, processed inputs, selected small
# source inputs, and canonical reporting outputs are retained.
# =============================================================================

# ---- R / RStudio session state ----------------------------------------------
.Rproj.user/
.Rhistory
.RData
.RDataTmp*
.Ruserdata
.Renviron
.Renviron.*

# ---- renv local state --------------------------------------------------------
# Keep renv.lock, .Rprofile, and renv/activate.R if they are created later.
renv/library/
renv/local/
renv/cellar/
renv/staging/
renv/python/
renv/sandbox/

# ---- Operating-system and editor files --------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo
*.tmp
*.temp
*.orig
*.bak
*.bak_*
*.bak*

# ---- Credentials and local configuration -----------------------------------
.env
.env.*
*.pem
*.key
credentials/
secrets/

# ---- R Markdown / knitr / Quarto generated files ----------------------------
*_files/
*_cache/
**/figure-html/
**/figure-latex/
.quarto/
*.utf8.md
*.knit.md
*.html

# ---- LaTeX build products ----------------------------------------------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb

# ---- Manuscript and thesis working directories ------------------------------
# These files remain on the local/Drive working copy but are not published in
# the code-and-data repository. No physical move is required.
/manuscript/
/PLOS_latex_template/
/errata/

# ---- Root-level manuscript/build artifacts ----------------------------------
# Publication figures intended for Git belong in figures_standalone/.
/*.docx
/*.pdf
/*.zip
/*.jpg
/*.jpeg
/*.png
/*.svg

# ---- Raw climate files: large and/or provider-controlled ---------------------
# Keep the small retrieval scripts, receipts, and documentation in data_raw/;
# only large climate data formats are excluded.
*.nc
*.nc4
*.grib
*.grb

# ---- Re-creatable pipeline state ---------------------------------------------
/data_interim/
/logs/

# Keep outputs/_canonical/, outputs/cross_scenario/, and outputs/tables/.
# Exclude mutable per-run working trees and audit/temporary output directories.
/outputs/ssp126/
/outputs/ssp245/
/outputs/ssp585/
/outputs/_audit/
/outputs/_frozen_unmatched/
/outputs/_to_delete/
/outputs/convexity_*.png

# ---- Rendered reports --------------------------------------------------------
/reports/_rendered/

# ---- Legacy, temporary, and ad-hoc folders ----------------------------------
**/_archive/
**/archive/
**/legacy_*/
/_to_delete/
/Yeni klasör/
/Yeni_klasor/
**/Yeni klasör/
**/Yeni_klasor/
**/eski_v3_yedek/

# ---- Local pipeline-diagram scratch files at repository root ----------------
/pipeline_diagram.R
/diagram_*.html
/diagram_*.svg

# ---- Shiny deployment metadata ----------------------------------------------
shiny_dengue_app/rsconnect/
